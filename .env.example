# Export these values in the shell. Never put the DB URL or pepper in frontend code.
# Default local SQLite is for trying the app; production uses Supabase Postgres.
DATABASE_URL=sqlite://hush.db?mode=rwc
APP_ORIGIN=http://localhost:8787
BIND=127.0.0.1:8787
# Required, at least 32 random characters. Generate: openssl rand -hex 32
PIN_PEPPER=replace-with-a-long-random-secret-before-running
# Supabase: use Session pooler for IPv4. URL-encode the password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

{
  "name": "whisper-browser-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "check:linux": "node scripts/check-container.mjs",
    "check:local": "node scripts/check.mjs",
    "check:ci": "node scripts/check.mjs --ci",
    "build": "node scripts/build-web.mjs",
    "test:edge": "node --test --test-concurrency=1 --experimental-test-coverage tests/edge/*.test.ts",
    "test": "node --test --experimental-test-coverage tests/*.test.js",
    "test:browser": "playwright test && node scripts/browser-coverage.mjs",
    "vendor:rich": "esbuild node_modules/dompurify/dist/purify.es.mjs --minify --format=esm --legal-comments=inline --outfile=web/vendor/purify.js",
    "vendor:markdown": "esbuild node_modules/marked/lib/marked.esm.js --minify --format=esm --legal-comments=inline --outfile=web/vendor/marked.js",
    "build:beta": "INCLUDE_MUSIC_BETA=1 node scripts/build-web.mjs",
    "dev:chat": "node scripts/edge-dev.ts",
    "test:chat": "CHAT_TESTS=1 playwright test -c playwright.chat.config.js",
    "test:music": "playwright test -c playwright.music.config.js",
    "dev": "vite",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "emoji:import": "node scripts/import-emoji-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "istanbul-lib-coverage": "^3.2.2",
    "marked": "^18.2.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-mart": "^5.6.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}

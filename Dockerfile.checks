# Keep local release checks and GitHub on the same Linux/browser/toolchains.
FROM node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS node
FROM rust:1.99.1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd AS rust
FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:714043ec4d54008d194a4b3835bc2a1156c51862d8bb45d72bea414f0ce9ed61
COPY --from=node /usr/local/ /usr/local/
COPY --from=rust /usr/local/cargo/ /usr/local/cargo/
COPY --from=rust /usr/local/rustup/ /usr/local/rustup/
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright WHISPER_PINNED_BROWSER=1 CI=1 CARGO_BUILD_JOBS=2
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy llvm-tools-preview \
    && cargo install cargo-llvm-cov --version 0.9.1 --locked
WORKDIR /app

COPY . .
